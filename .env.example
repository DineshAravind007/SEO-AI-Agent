# ==============================================================================
# Website SEO AI Agent - Environment Configuration (.env.example)
# Copy this file to .env and adjust variables for your local/production environment.
# ==============================================================================

# ── Application & Security ───────────────────────────────────────────────────
# Secret key used for signing JWT access tokens (minimum 32 characters in production)
JWT_SECRET=super-secret-jwt-token-key-minimum-32-chars-long-for-hmac-sha256

# Secret key used for Starlette session middleware
SESSION_SECRET=super-secret-session-key-change-in-production-env

# Allowed frontend origins for CORS (comma-separated for multiple origins)
FRONTEND_ORIGIN=http://localhost:5173

# Frontend URL used for OAuth callbacks and browser redirects
FRONTEND_URL=http://localhost:5173

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite is used by default for local development.
# For production, supply a PostgreSQL connection string.
DATABASE_URL=sqlite:///./seo_agent.db
# DATABASE_URL=postgresql://postgres:password@localhost:5432/seo_agent

# ── AI / LLM Provider ────────────────────────────────────────────────────────
# Provider type: "mock" (default, no API key required), "openai", or "gemini"
LLM_PROVIDER=mock

# ── OpenAI provider (LLM_PROVIDER=openai) ────────────────────────────────────
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# ── Google Gemini provider (LLM_PROVIDER=gemini) ─────────────────────────────
# Obtain a key at https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=AIza...
# LLM_MODEL=gemini-2.5-flash-lite   # default when LLM_PROVIDER=gemini

# ── Shared LLM settings ───────────────────────────────────────────────────────
LLM_TIMEOUT=60

# ── Google Search Console (OAuth 2.0) ────────────────────────────────────────
# Required only if Google Search Console integration is enabled
# GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/gsc/auth/callback

# ── Email & Notification Settings (SMTP) ─────────────────────────────────────
# Configure with your SMTP relay (e.g. Mailtrap for dev, SendGrid / Postmark for prod)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_USERNAME=your_smtp_username
EMAIL_PASSWORD=your_smtp_password
EMAIL_FROM=noreply@seo-agent.local

# ── Frontend Configuration (Vite) ────────────────────────────────────────────
# Set in frontend/.env if frontend is served on a different domain/port
VITE_API_BASE_URL=http://localhost:8000
